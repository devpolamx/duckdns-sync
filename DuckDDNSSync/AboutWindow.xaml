<ui:FluentWindow x:Class="DuckDDNSSync.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Acerca de" Height="320" Width="340" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Acerca de" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/ducky_icon.png"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Margin="20" HorizontalAlignment="Center">
            <Image Source="Assets/ducky_icon.png" Width="64" Height="64" Margin="0,0,0,12"/>
            <TextBlock Text="DuckDNS Sync" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,2,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="IOSoluciones" HorizontalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="Carlos A. Pola Díaz" HorizontalAlignment="Center" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Button Content="linkedin.com/in/devpolamx" Tag="https://www.linkedin.com/in/devpolamx/"
                    Click="LinkClick" HorizontalAlignment="Center" Cursor="Hand"/>
        </StackPanel>
    </DockPanel>
</ui:FluentWindow>
